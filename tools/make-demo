#!/usr/bin/env python3
"""Copy demo-vault/ to a scratch folder, filling in dates relative to today.

    make-demo SRC DEST     (DEST is replaced)

In the template, {{d+3}} becomes the date three days from today
(YYYY-MM-DD) and {{dc-14}} the compact form (YYYYMMDD) used in recurrence
rules, so a copy made any day has something due today, overdue and upcoming.
"""
import os
import re
import shutil
import sys
from datetime import date, timedelta

TOKEN = re.compile(r"\{\{d(c?)([+-]\d+)\}\}")


def fill(text, today):
    def sub(m):
        d = today + timedelta(days=int(m.group(2)))
        return d.strftime("%Y%m%d") if m.group(1) else d.isoformat()
    return TOKEN.sub(sub, text)


def main():
    src, dest = sys.argv[1], sys.argv[2]
    if os.path.exists(dest):
        shutil.rmtree(dest)
    shutil.copytree(src, dest)
    today = date.today()
    for dirpath, _dirs, files in os.walk(dest):
        for fn in files:
            if fn.endswith((".md", ".base")):
                p = os.path.join(dirpath, fn)
                with open(p, encoding="utf-8") as f:
                    text = f.read()
                with open(p, "w", encoding="utf-8") as f:
                    f.write(fill(text, today))
    print(dest)


main()
